# ===============================
# OSEC Environment Configuration
# ===============================

# Application
API_BASE_URL=http://localhost:3000/api/v1
NODE_ENV=development

# Database
DATABASE_URL=mongodb://localhost:27017/osec

# Authentication
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=10

# MTN Mobile Money
MTN_MOBILE_MONEY_API_KEY=your-mtn-api-key
MTN_MOBILE_MONEY_API_SECRET=your-mtn-api-secret
MTN_MOBILE_MONEY_ENVIRONMENT=sandbox

# Orange Money
ORANGE_MONEY_API_KEY=your-orange-api-key
ORANGE_MONEY_API_SECRET=your-orange-api-secret
ORANGE_MONEY_ENVIRONMENT=sandbox

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-west-3
S3_BUCKET_NAME=osec-video-storage
S3_VIDEO_PREFIX=encrypted-courses
CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

# Firebase Cloud Messaging
FIREBASE_SERVER_KEY=your-firebase-server-key

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# Redis (for caching & session)
REDIS_URL=redis://localhost:6379

# Video Encryption
VIDEO_ENCRYPTION_KEY=your-32-byte-hex-encryption-key
VIDEO_ENCRYPTION_IV=your-16-byte-hex-initialization-vector
